# Copy to .env and edit. The .env file is gitignored — never commit it.
#   cp .env.example .env && chmod 600 .env

# Orthanc HTTP credentials. Use a real password, not a placeholder:
# HTTP Basic auth is only base64-encoded, and appears in trace-level logs.
ORTHANC_USER=admin
ORTHANC_PASSWORD=

# Host port nginx publishes for TLS.
TLS_PORT=445

# Orthanc identity
ORTHANC_NAME=orthanc
ORTHANC_AET=ORTHANC

# Logging. Set TRACE_ENABLED=true only for short debugging sessions:
# trace logs every HTTP header, including Authorization.
VERBOSE_ENABLED=true
VERBOSE_STARTUP=true
